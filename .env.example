# Local Supabase stack. Get these from `supabase status` after `supabase start`.
# The anon key is PUBLIC by design -- it only carries `role: anon`, and RLS is the
# actual security boundary. It is safe to commit and to ship in the browser bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=

# NOT prefixed with VITE_ on purpose: the service role key bypasses RLS entirely
# and must never reach src/ or the browser bundle. Used only by scripts/seed-admin.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# The address printed on the projector's QR code and "Join at" line. Pin this to
# the domain on your slides -- otherwise the room is sent to whatever host the
# display laptop happens to be on. Falls back to the current origin if unset.
VITE_PUBLIC_URL=

# Optional: admin accounts created by `npm run seed:admin`
SEED_ADMIN_EMAILS=organizer1@dcstateofthestack.org,organizer2@dcstateofthestack.org
SEED_ADMIN_PASSWORD=openspaces-local-dev
